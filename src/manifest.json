{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "version": "0.2.0",
  "author": "SPYder4",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "audiorectab@lyapupastar",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "permissions": ["downloads", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["stream.js", "fastsave.js", "background.js"] },
  "action": {
    "default_title": "__MSG_extShort__",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "page_action": {
    "default_title": "__MSG_extShort__",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "options_ui": { "page": "options.html" },
  "commands": {
    "toggle-record": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "__MSG_cmdRecord__" },
    "toggle-watch": { "suggested_key": { "default": "Alt+Shift+W" }, "description": "__MSG_cmdWatch__" },
    "fast-save": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "__MSG_cmdFast__" },
    "_execute_page_action": { "suggested_key": { "default": "Alt+Shift+O" }, "description": "__MSG_cmdOpen__" }
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
